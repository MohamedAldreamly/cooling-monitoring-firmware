# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.3.1 Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
# CONFIG_FIRMWARE_E2E_STORAGE_TEST is not set

CONFIG_FIRMWARE_WIFI_ENABLED=y
CONFIG_FIRMWARE_WIFI_SSID="Wokwi-GUEST"
CONFIG_FIRMWARE_WIFI_PASSWORD=""
CONFIG_FIRMWARE_WIFI_MAXIMUM_RETRY=10

CONFIG_FIRMWARE_WIFI_FAULT_TEST=y
